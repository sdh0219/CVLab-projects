{
  "data": {
    "disaster_points_file": "../../数据集/processed_data/henan_disaster_processed_data.py",
    "use_simulation": false
  },
  "algorithm": {
    "pop_size": 100,
    "generations": 50,
    "mutation_rate": 0.1,
    "crossover_rate": 0.8,
    "elite_ratio": 0.1,
    "selection_pressure": 2
  },
  "objectives": {
    "satisfaction": {
      "weight": 0.35,
      "enabled": true,
      "description": "物资满足率"
    },
    "transport_cost": {
      "weight": 0.15,
      "enabled": true,
      "description": "运输成本（考虑道路状况）"
    },
    "fairness": {
      "weight": 0.2,
      "enabled": true,
      "description": "分配公平性（满足率方差倒数）"
    },
    "urgency": {
      "weight": 0.2,
      "enabled": true,
      "description": "紧急程度加权得分"
    },
    "time_efficiency": {
      "weight": 0.1,
      "enabled": true,
      "description": "时间效率（运输时间倒数）"
    }
  },
  "constraints": {
    "inventory_limit": {
      "enabled": true,
      "description": "库存约束：分配量不超过仓库库存"
    },
    "demand_limit": {
      "enabled": true,
      "description": "需求约束：分配量不超过受灾点需求"
    },
    "vehicle_limit": {
      "enabled": true,
      "description": "车辆约束：运输量不超过车辆运力"
    },
    "repair_method": "ratio"
  },
  "output": {
    "save_plots": true,
    "save_data": true,
    "output_dir": "output_universal",
    "dpi": 300
  },
  "logging": {
    "verbose": true,
    "save_history": true
  }
}
