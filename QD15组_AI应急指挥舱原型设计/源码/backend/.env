# AI应急指挥舱后端配置

# 数据库配置 - SQLite真实数据版
DATABASE_URL=sqlite:///./emergency_command.db

# Redis配置
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# AI配置
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# 服务配置
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
